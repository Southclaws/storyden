{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "sort-imports": [
      "error",
      {
        "ignoreCase": false,
        "ignoreDeclarationSort": true
      }
    ]
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "coverage/**",
    "storybook-static/**",
    "playwright-report/**",
    "test-results/**",
    "styled-system/**",
    "src/api/openapi-client/**",
    "src/api/openapi-server/**",
    "src/api/openapi-schema/**",
    "src/api/robots.ts",
    "src/lib/webmcp/tools.generated.ts"
  ]
}
