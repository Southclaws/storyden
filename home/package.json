{
  "name": "homepage",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsx scripts/refresh-home-stats.ts && next build",
    "stats:refresh": "tsx scripts/refresh-home-stats.ts --github",
    "dev": "next dev",
    "start": "next start",
    "prepare": "panda codegen",
    "openapi": "tsx --conditions=import generate-openapi.ts",
    "postinstall": "fumadocs-mdx",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxlint --config .oxlintrc.sort.json --disable-nested-config --fix . && oxfmt .",
    "format:check": "oxlint --config .oxlintrc.sort.json --disable-nested-config . && oxfmt --check ."
  },
  "dependencies": {
    "@fuma-translate/react": "^1.0.2",
    "@fumadocs/mdx-remote": "1.5.3",
    "@radix-ui/react-popover": "^1.3.1",
    "@uidotdev/usehooks": "2.4.1",
    "autoprefixer": "10.6.2",
    "class-variance-authority": "^0.7.1",
    "date-fns": "4.4.0",
    "feed": "6.0.0",
    "framer-motion": "14.9.0",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-openapi": "12.5.7",
    "fumadocs-ui": "16.17.9",
    "lodash": "4.18.1",
    "lucide-react": "1.66.0",
    "marked": "18.1.2",
    "mermaid": "12.2.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0",
    "tailwind-merge": "^3.7.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fumadocs/cli": "^1.7.6",
    "@pandacss/dev": "2.4.0",
    "@pandacss/preset-base": "2.4.0",
    "@pandacss/preset-panda": "2.4.0",
    "@types/lodash": "4.17.27",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
